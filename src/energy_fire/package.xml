<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>energy_fire</name>
  <version>0.0.0</version>
  <description>Little energy client node: calls predict_energy and compute_target_location services, solves pitch via ballistic calculation, and publishes /gimbal_command.</description>
  <maintainer email="user@todo.todo">user</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2</depend>
  <build_depend>rosidl_cmake</build_depend>
  <depend>energy_fitting</depend>
  <depend>energy_pose_transform</depend>

  <exec_depend>python3-launch-ros</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
