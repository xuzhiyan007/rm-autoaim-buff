#####-----tracker参数-----#####
min_detect_count: 5
max_temp_lost_count: 15
outpost_max_temp_lost_count: 75

#####-----aimer参数-----#####
yaw_offset: -0.8 # degree -2.5
pitch_offset: -4 # degree 2
comming_angle: 45 # degree
leaving_angle: 18 # degree
decision_speed: 7 # rad/s
high_speed_delay_time: 0.075 # s
low_speed_delay_time: 0.075  # s planner use this value
#####-----shooter参数-----#####
first_tolerance: 1.35 #1.5 # 近距离射击容差，degree
second_tolerance: 1.35 #1.2 # 远距离射击容差，degree
judge_distance: 3.5 #距离判断阈值
auto_fire: true # 是否由自瞄控制射击
#####-----processor_node参数-----#####
bullet_speed: 23.0 # m/s

